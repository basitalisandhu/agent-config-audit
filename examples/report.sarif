       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "category": "mcp",
        "security-severity": "5.0",
        "tags": [
         "security",
         "agent-configuration",
         "mcp"
        ]
       }
      },
      {
       "id": "MCP-004",
       "name": "MCPserverrunsfromatemporarydirectory",
       "shortDescription": {
        "text": "MCP server runs from a temporary directory"
       },
       "fullDescription": {
        "text": "An unreviewed, easily replaced binary."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#mcp-004",
