       "name": "MCPserverstartedwithsafetychecksdisabled",
       "shortDescription": {
        "text": "MCP server started with safety checks disabled"
       },
       "fullDescription": {
        "text": "Flags such as --dangerously-skip-permissions or a shell -c launch."
