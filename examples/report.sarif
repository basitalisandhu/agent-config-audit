      {
       "id": "INJ-004",
       "name": "Remotecodeexecutionorauto-runinstruction",
       "shortDescription": {
        "text": "Remote code execution or auto-run instruction"
       },
       "fullDescription": {
        "text": "curl piped into a shell, or 'always run' and 'on every session start run'."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#inj-004",
