        "tags": [
         "security",
         "agent-configuration",
         "mcp"
        ]
       }
      },
      {
       "id": "MCP-002",
       "name": "LiteralcredentialinMCPserverconfig",
       "shortDescription": {
        "text": "Literal credential in MCP server config"
       },
       "fullDescription": {
        "text": "A token in headers or env is committed with the config instead of referenced as ${VAR}."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#mcp-002",
       "help": {
