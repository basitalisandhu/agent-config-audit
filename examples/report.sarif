{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "agent-config-audit",
     "version": "0.2.0",
     "semanticVersion": "0.2.0",
     "informationUri": "https://github.com/basitalisandhu/agent-config-audit",
     "rules": [
      {
       "id": "PERM-001",
       "name": "Anyshellcommandpre-approved",
       "shortDescription": {
        "text": "Any shell command pre-approved"
       },
       "fullDescription": {
        "text": "Bash or Bash(*) in permissions.allow lets every shell command run without a prompt."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#perm-001",
       "help": {
        "text": "Bash or Bash(*) in permissions.allow lets every shell command run without a prompt."
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "category": "permissions",
        "security-severity": "9.5",
        "tags": [
         "security",
         "agent-configuration",
         "permissions"
        ]
       }
      },
      {
       "id": "PERM-002",
       "name": "Riskyprogrampre-approved",
       "shortDescription": {
        "text": "Risky program pre-approved"
       },
       "fullDescription": {
        "text": "A program such as rm, sudo, curl, bash or a package manager is pre-approved with a wildcard, so one injected instruction becomes an executed command."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#perm-002",
       "help": {
        "text": "A program such as rm, sudo, curl, bash or a package manager is pre-approved with a wildcard, so one injected instruction becomes an executed command."
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "category": "permissions",
        "security-severity": "8.0",
        "tags": [
         "security",
         "agent-configuration",
         "permissions"
        ]
       }
      },
      {
       "id": "PERM-003",
       "name": "Permissionpromptsbypassed",
       "shortDescription": {
        "text": "Permission prompts bypassed"
       },
       "fullDescription": {
        "text": "defaultMode bypassPermissions, dontAsk or auto, permissionMode in agent front matter, or a Codex approval policy of never removes the human from the loop."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#perm-003",
       "help": {
        "text": "defaultMode bypassPermissions, dontAsk or auto, permissionMode in agent front matter, or a Codex approval policy of never removes the human from the loop."
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "category": "permissions",
        "security-severity": "9.5",
        "tags": [
         "security",
         "agent-configuration",
         "permissions"
        ]
       }
      },
      {
       "id": "PERM-004",
       "name": "WriteorEditpre-approvedforeverypath",
       "shortDescription": {
        "text": "Write or Edit pre-approved for every path"
       },
       "fullDescription": {
        "text": "The agent can rewrite its own hooks and settings."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#perm-004",
       "help": {
        "text": "The agent can rewrite its own hooks and settings."
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "category": "permissions",
        "security-severity": "5.0",
        "tags": [
         "security",
         "agent-configuration",
         "permissions"
        ]
       }
      },
      {
       "id": "PERM-005",
       "name": "Webaccesspre-approvedforeverydomain",
       "shortDescription": {
        "text": "Web access pre-approved for every domain"
       },
       "fullDescription": {
        "text": "Unrestricted WebFetch or WebSearch is a data-exfiltration channel under prompt injection."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#perm-005",
       "help": {
        "text": "Unrestricted WebFetch or WebSearch is a data-exfiltration channel under prompt injection."
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "category": "permissions",
        "security-severity": "5.0",
        "tags": [
         "security",
         "agent-configuration",
         "permissions"
        ]
       }
      },
      {
       "id": "PERM-006",
       "name": "WholeMCPserverpre-approved",
       "shortDescription": {
        "text": "Whole MCP server pre-approved"
       },
       "fullDescription": {
        "text": "Every tool of the server, including write and delete tools, runs without a prompt."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#perm-006",
       "help": {
        "text": "Every tool of the server, including write and delete tools, runs without a prompt."
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "category": "permissions",
        "security-severity": "5.0",
        "tags": [
         "security",
         "agent-configuration",
         "permissions"
        ]
       }
      },
      {
       "id": "PERM-007",
       "name": "AllprojectMCPserversauto-approved",
       "shortDescription": {
        "text": "All project MCP servers auto-approved"
       },
       "fullDescription": {
        "text": "A cloned repository's .mcp.json would start processes automatically."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#perm-007",
       "help": {
        "text": "A cloned repository's .mcp.json would start processes automatically."
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "category": "permissions",
        "security-severity": "5.0",
        "tags": [
         "security",
         "agent-configuration",
         "permissions"
        ]
       }
      },
      {
       "id": "PERM-008",
       "name": "Allhooksdisabled",
       "shortDescription": {
        "text": "All hooks disabled"
       },
       "fullDescription": {
        "text": "Guard hooks such as secret-exposure blocking do not run."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#perm-008",
       "help": {
        "text": "Guard hooks such as secret-exposure blocking do not run."
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "category": "permissions",
        "security-severity": "5.0",
        "tags": [
         "security",
         "agent-configuration",
         "permissions"
        ]
       }
      },
      {
       "id": "PERM-009",
       "name": "Permission-bypassflaginanallowrule",
       "shortDescription": {
        "text": "Permission-bypass flag in an allow rule"
       },
       "fullDescription": {
        "text": "A pre-approved command carries a flag such as --dangerously-skip-permissions."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#perm-009",
       "help": {
        "text": "A pre-approved command carries a flag such as --dangerously-skip-permissions."
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "category": "permissions",
        "security-severity": "8.0",
        "tags": [
         "security",
         "agent-configuration",
         "permissions"
        ]
       }
      },
      {
       "id": "PERM-010",
       "name": "Wholehomeorrootdirectorygranted",
       "shortDescription": {
        "text": "Whole home or root directory granted"
       },
       "fullDescription": {
        "text": "additionalDirectories includes /, ~ or the home directory."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#perm-010",
       "help": {
        "text": "additionalDirectories includes /, ~ or the home directory."
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "category": "permissions",
        "security-severity": "5.0",
        "tags": [
         "security",
         "agent-configuration",
         "permissions"
        ]
       }
      },
      {
       "id": "PERM-011",
       "name": "Broadallowruleswithnodenyrules",
       "shortDescription": {
        "text": "Broad allow rules with no deny rules"
       },
       "fullDescription": {
        "text": "There is no backstop for the obvious disasters."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#perm-011",
       "help": {
        "text": "There is no backstop for the obvious disasters."
       },
       "defaultConfiguration": {
        "level": "note"
       },
       "properties": {
        "category": "permissions",
        "security-severity": "2.0",
        "tags": [
         "security",
         "agent-configuration",
         "permissions"
        ]
       }
      },
      {
       "id": "PERM-012",
       "name": "Readallowcoversasecret-bearingpath",
       "shortDescription": {
        "text": "Read allow covers a secret-bearing path"
       },
       "fullDescription": {
        "text": "A Read allow rule covers environment files, credential stores or private-key paths."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#perm-012",
       "help": {
        "text": "A Read allow rule covers environment files, credential stores or private-key paths."
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "category": "permissions",
        "security-severity": "5.0",
        "tags": [
         "security",
         "agent-configuration",
         "permissions"
        ]
       }
      },
      {
       "id": "HOOK-001",
       "name": "Hookscriptdoesnotexist",
       "shortDescription": {
        "text": "Hook script does not exist"
       },
       "fullDescription": {
        "text": "The control the hook was meant to add is absent; failure mode depends on the host."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#hook-001",
       "help": {
        "text": "The control the hook was meant to add is absent; failure mode depends on the host."
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "properties": {
        "category": "hooks",
        "security-severity": "5.0",
        "tags": [
         "security",
         "agent-configuration",
         "hooks"
        ]
       }
      },
      {
       "id": "HOOK-002",
       "name": "Hookcanreachthenetwork",
       "shortDescription": {
        "text": "Hook can reach the network"
       },
       "fullDescription": {
        "text": "Hook input contains commands, paths and prompts; a hook that calls curl, ssh or a remote URL can exfiltrate them."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#hook-002",
       "help": {
        "text": "Hook input contains commands, paths and prompts; a hook that calls curl, ssh or a remote URL can exfiltrate them."
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "category": "hooks",
        "security-severity": "8.0",
        "tags": [
         "security",
         "agent-configuration",
         "hooks"
        ]
       }
      },
      {
       "id": "HOOK-003",
       "name": "Credentialinsideahookcommand",
       "shortDescription": {
        "text": "Credential inside a hook command"
       },
       "fullDescription": {
        "text": "A known credential format sits in a settings file."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#hook-003",
       "help": {
        "text": "A known credential format sits in a settings file."
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "category": "hooks",
        "security-severity": "9.5",
        "tags": [
         "security",
         "agent-configuration",
         "hooks"
        ]
       }
      },
      {
       "id": "HOOK-004",
       "name": "Hookpipesremotecontentintoashell",
       "shortDescription": {
        "text": "Hook pipes remote content into a shell"
       },
       "fullDescription": {
        "text": "Remote code runs on every tool call."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#hook-004",
       "help": {
        "text": "Remote code runs on every tool call."
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "category": "hooks",
        "security-severity": "9.5",
        "tags": [
         "security",
         "agent-configuration",
         "hooks"
        ]
       }
      },
      {
       "id": "HOOK-005",
       "name": "UnquotedCLAUDE_PLUGIN_ROOTinashell-formhook",
       "shortDescription": {
        "text": "Unquoted CLAUDE_PLUGIN_ROOT in a shell-form hook"
       },
       "fullDescription": {
        "text": "Breaks on paths with spaces."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#hook-005",
       "help": {
        "text": "Breaks on paths with spaces."
       },
       "defaultConfiguration": {
        "level": "note"
       },
       "properties": {
        "category": "hooks",
        "security-severity": "2.0",
        "tags": [
         "security",
         "agent-configuration",
         "hooks"
        ]
       }
      },
      {
       "id": "HOOK-006",
       "name": "Hookscriptisworld-writable",
       "shortDescription": {
        "text": "Hook script is world-writable"
       },
       "fullDescription": {
        "text": "Anyone local can change what runs on every tool call."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#hook-006",
       "help": {
        "text": "Anyone local can change what runs on every tool call."
       },
       "defaultConfiguration": {
        "level": "error"
       },
       "properties": {
        "category": "hooks",
        "security-severity": "8.0",
        "tags": [
         "security",
         "agent-configuration",
         "hooks"
        ]
       }
      },
      {
       "id": "MCP-001",
       "name": "MCPserveroverplainHTTP",
       "shortDescription": {
        "text": "MCP server over plain HTTP"
       },
       "fullDescription": {
        "text": "Credentials and tool results travel in clear text."
       },
       "helpUri": "https://github.com/basitalisandhu/agent-config-audit/blob/main/docs/checks.md#mcp-001",
